<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P01DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             Background="{StaticResource Brush.White}">

  <!--
    p01 仪表板。对应 mockup/pages/p01-dashboard.html。
    竖向结构：区块标题 → 属性表 → 开始使用清单（仅首次运行）→ 1px 分隔线 → 事件表（填满剩余空间）。
    实例展示 / 快切列表已按用户要求移除（2026-10-24），实例入口在左侧导航与 p02。
    只有最后一行是 *，其余都是 Auto —— 这与设计稿的 .events.fill 是同一个意思。
  -->

  <!--
    页面整体滚动：窗口高度不足时滚动整页，而不是把事件表或页头裁掉。
    MinHeight 绑定到 ScrollViewer 视口高度，保证内容够高时最后一行的 * 仍然填满；
    内容超过视口时才出现右侧原生垂直滚动条。
  -->
  <ScrollViewer x:Name="PageScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                CanContentScroll="False">
    <Grid MinHeight="{Binding ActualHeight, ElementName=PageScroll}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

    <!-- ==================== 区块标题 ==================== -->
    <c:SectionHeader Grid.Row="0"
                     Icon="&#xEC4A;"
                     Title="{Binding SectionTitle}"
                     Subtitle="{Binding SectionSubtitle}" />

    <!-- ==================== 属性表：左半当前实例 / 右半本机信息 ====================
         4 等分列（对应 shell.css 的 grid-template-columns:repeat(4, minmax(0,1fr))）。
         第 3 列前面那条 1px 竖线由独立的 Border 承担，跨全部 7 行。 -->
    <Grid Grid.Row="1" Style="{StaticResource PropsBox}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
      </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="2" Style="{StaticResource PropsDivider}" />

      <!-- 左列：硬件 / 运行环境；右列：当前游戏信息；各 6 项。 -->
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 操作系统版本}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SystemInfo.OperatingSystem}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 当前实例}" />
      <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.Name}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 已安装的内存}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SystemInfo.InstalledMemory}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 游戏版本}" />
      <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.GameVersion}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 处理器}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SystemInfo.Processor}" />
      <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 模组加载器}" />
      <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LoaderDisplay}" />

      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 显卡}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SystemInfo.GraphicsCard}" />
      <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 上次启动}" />
      <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LastLaunched}" />

      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text Java 运行时}" />
      <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.JavaRuntimeSummary}" />
      <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 内存分配}" />
      <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.MemoryText}" />

      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 游戏目录}" />
      <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.GameDirectory}" />
      <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 实例占用空间}" />
      <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.SizeOnDisk}" />
    </Grid>

    <!-- ==================== 首次运行清单 ==================== -->
    <!-- 2026-10-24 用户要求去掉实例展示（快切列表）；这里只保留零实例 / 缺少账户或 Java 时的「开始使用」。 -->
    <Grid Grid.Row="3">
      <Border Margin="18,10,18,0"
              Padding="12,10"
              Background="{StaticResource Brush.RowAlternate}"
              BorderBrush="{StaticResource Brush.RowBorder}"
              BorderThickness="1"
              Visibility="{Binding HasFirstRunIssues, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Text="{loc:Text 开始使用}"
                     Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding FirstRunIssues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Text="{Binding Detail}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource LinkButton}"
                          Content="{Binding ActionText}"
                          Command="{Binding Command}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
<!-- 2026-10-24 用户要求：去掉「实例设置 / 管理实例 / 模组」三颗按钮，动作条整个移除。 -->
    <Border Grid.Row="5" Style="{StaticResource HairLine}" />

    <!-- ==================== 事件表（填满剩余高度） ==================== -->
    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0" Icon="&#xE9D5;" Title="{loc:Text 事件}" Padding="18,0,18,6" />

      <TextBlock Grid.Row="1" Margin="18,0,18,4" Text="{Binding EventCountText}" />

      <!-- 2026-10-24 用户要求：筛选器与工具参照实例详情（InstanceOverviewPanel）的事件区块。 -->
      <Grid Grid.Row="2" Style="{StaticResource FilterRow}" Margin="18,0,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource FilterBoxBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}" FontSize="12" Text="&#xE71C;" />
            <!-- 占位文本垫在输入框下面，只在输入为空时显示（设计稿的「筛选器」是占位符） -->
            <TextBlock Grid.Column="1"
                       Margin="6,0,6,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="{loc:Text 筛选器}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EventFilterText}" Value="" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=DashboardFilterBox}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="DashboardFilterBox"
                     Grid.Column="1"
                     Margin="6,0,6,0"
                     Padding="0"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Text="{Binding EventFilterText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icon}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="&#xE721;" />
          </Grid>
        </Border>
        <c:IconButton Grid.Column="1"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE8CB;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 切换事件排序方向}"
                      Command="{Binding ToggleEventSortCommand}" />
        <c:IconButton Grid.Column="2"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE72C;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 立即重读事件}"
                      Command="{Binding RefreshEventsCommand}" />
        <TextBlock Grid.Column="3"
                   Margin="12,0,12,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{Binding FilterHintText}" />
        <ComboBox Grid.Column="4"
                  MinWidth="0"
                  HorizontalAlignment="Right"
                  ItemsSource="{Binding EventLevelChoices}"
                  ItemTemplate="{StaticResource ChoiceOptionText}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding EventLevelChoice, Mode=TwoWay}" />
      </Grid>

      <DataGrid Grid.Row="3"
                Margin="18,16,18,12"
                ItemsSource="{Binding FilteredEvents}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="150" Header="{loc:Text 实例名称}" Binding="{Binding InstanceName}" />
          <!-- 设计稿给 ID 列 44px。WPF 的 Segoe UI 字宽比浏览器略宽，44px 减去左右各 8px
               内边距后放不下四位数字（最后一位会被切掉），所以放宽到 48px。
               行高 24px、表头 #fafafa 等 §5.2 量化特征均未改动。 -->
          <DataGridTextColumn Width="48" Header="ID" Binding="{Binding Id}" />
          <DataGridTemplateColumn Width="64" Header="{loc:Text 级别}" CellTemplate="{StaticResource EventLevelCell}" />
          <DataGridTemplateColumn Width="110" Header="{loc:Text 来源}" CellTemplate="{StaticResource EventSourceCell}" />
          <!--
            消息列：设计稿给的是固定 170px（`colgroup` 第 5 列），而**来源**那一列是 auto。
            2026-10-06（M6-b）事件文案改成「键 + 参数」之后消息普遍变长（例：
            `已更新版本清单（918 个版本，最新正式版 26.3，2026-10-06 22:36）`），170px 只够十四五个汉字；
            而来源只有「下载器 / Java 运行时」这种短标签 —— 让消息吃剩余宽度、来源固定 110px，
            其余五列仍是设计稿的宽度。完整句子另有 ToolTip（截断时也读得到）。
          -->
          <DataGridTextColumn Width="*" Header="{loc:Text 消息}" Binding="{Binding Message}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Message}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Width="130" Header="{loc:Text 时间}" Binding="{Binding Time}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
