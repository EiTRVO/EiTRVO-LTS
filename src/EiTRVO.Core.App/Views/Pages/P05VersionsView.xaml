<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P05VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             xmlns:lvc="clr-namespace:EiTRVO.Core.Launcher.Versions;assembly=EiTRVO.Core.Launcher"
             Background="{StaticResource Brush.White}">

  <!--
    p05 所有版本。对应 mockup/pages/p05-versions.html。
    结构：区块标题 → 筛选行 → 版本表格（固定 8 行视口 = 216px）→ 贴底动作条。
    2026-10-24 用户要求去掉「本地状态」「操作」两列，剩余四列按比例铺满表格宽度。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0"
                       Icon="&#xE81E;"
                       Title="{Binding SectionTitle}"
                       Subtitle="{Binding SectionSubtitle}" />

      <Grid Grid.Row="1" Style="{StaticResource FilterRow}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource FilterBoxBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}" FontSize="12" Text="&#xE71C;" />
            <!-- 占位文本垫在输入框下面，只在输入为空时显示（设计稿的「筛选器」是占位符） -->
            <TextBlock Grid.Column="1"
                       Margin="6,0,6,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="{loc:Text 筛选器}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding FilterText}" Value="" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=VersionsFilterBox}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="VersionsFilterBox"
                     Grid.Column="1"
                     Margin="6,0,6,0"
                     Padding="0"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icon}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="&#xE721;" />
          </Grid>
        </Border>
        <!-- 设计稿 .filterrow 里有三个图标；E70B 是文档形、行为未定义，2026-10-24 用户要求去掉。 -->
        <c:IconButton Grid.Column="2"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE72C;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 重新获取版本清单}"
                      Command="{Binding RefreshCommand}" />
        <c:IconButton Grid.Column="3"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE72D;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 重置筛选}"
                      Command="{Binding ResetFilterCommand}" />
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource Brush.TextMuted}" Text="{loc:Text 仅显示：}" />
          <Button Command="{Binding ShowReleasesCommand}" Content="{loc:Text 正式版}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsShowingReleases}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock Margin="4,0,4,0" Foreground="{StaticResource Brush.TextMuted}" Text="|" />
          <Button Command="{Binding ShowSnapshotsCommand}" Content="{loc:Text 快照}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsShowingSnapshots}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock Margin="4,0,4,0" Foreground="{StaticResource Brush.TextMuted}" Text="|" />
          <Button Command="{Binding ShowAllCommand}" Content="{loc:Text 全部}">
            <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource LinkButton}">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsShowingAll}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Grid>

      <DataGrid Grid.Row="2"
                Height="216"
                Margin="18,0,18,12"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                SelectedItem="{Binding SelectedVersion}"
                ItemsSource="{Binding FilteredVersions}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="2*" Header="{loc:Text 版本}" Binding="{Binding Id}" />
          <DataGridTemplateColumn Width="*" Header="{loc:Text 类型}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock x:Name="Txt" VerticalAlignment="Center" Text="{loc:Text 正式版}" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static lvc:VersionKind.Snapshot}">
                    <Setter TargetName="Txt" Property="Text" Value="{loc:Text 快照}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="1.3*" Header="{loc:Text 发布日期}" Binding="{Binding ReleaseDate}" />
          <DataGridTextColumn Width="*" Header="{loc:Text 所需 Java}" Binding="{Binding RequiredJava}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource ActionBarDocked}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <c:IconButton Icon="&#xE713;"
                        Text="{loc:Text 管理 Java 运行时}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:PageId.JavaSettings}" />
        </WrapPanel>
        <c:IconButton Grid.Column="1"
                      Icon="&#xE710;"
                      Text="{loc:Text 用所选版本新建实例}"
                      HorizontalAlignment="Right"
                      ToolTip="{Binding NewInstanceLockedReason}"
                      ToolTipService.ShowOnDisabled="True"
                      Command="{Binding CreateInstanceCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
