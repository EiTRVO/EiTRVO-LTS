<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P14LaunchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             xmlns:ldc="clr-namespace:EiTRVO.Core.Launcher.Downloads;assembly=EiTRVO.Core.Launcher"
             Background="{StaticResource Brush.White}">

  <!--
    p14 正在启动。对应 mockup/pages/p14-dialog-launching.html。
    结构：区块标题 → 启动进度属性表（2 列）→ 失败提示条（有失败时才有高度）→ 1px 分隔线 →
          4 个阶段列表 → 贴底动作条（取消启动）。
    2026-10-24 用户要求去掉左下角「查看实时日志」与「查看下载队列」按钮。
    M4-d 起这里的阶段、进度、当前动作、Java、内存全部来自真实的启动会话。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0" Icon="&#xE768;" Title="{Binding SectionTitle}" Subtitle="{Binding SectionSubtitle}" />

      <Grid Grid.Row="1" Style="{StaticResource PropsBox}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 当前阶段}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Text="{Binding CurrentStageText}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 总体进度}" />
        <c:MiniProgressBar Grid.Row="1" Grid.Column="1" BarWidth="420" Value="{Binding Percent}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 文件进度}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding FileProgressText}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 速度}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SpeedText}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 当前文件}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.PropValue}"
                   Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                   Text="{Binding CurrentFileText}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text Java 运行时}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.PropValue}" Text="{Binding JavaRuntimeText}" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.StateOk}" Text="{loc:Text 已校验}"
                     Visibility="{Binding IsJavaVerified, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 内存分配}" />
        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding MemoryText}" />
      </Grid>

      <!-- 失败提示条：设计稿里没有"启动失败"这个状态，但启动会失败（缺文件、缺 Java、没账户……），
           而理由必须看得见 —— 只把理由塞进某一格灰字里，用户会以为"卡住了"。 -->
      <c:Banner Grid.Row="2"
                Icon="&#xE783;"
                Tone="Error"
                Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
        <TextBlock TextWrapping="Wrap" LineHeight="20" Text="{Binding Failure}" />
      </c:Banner>

      <Border Grid.Row="3" Style="{StaticResource HairLine}" />

      <c:SectionHeader Grid.Row="4" Icon="&#xE9D5;" Title="{loc:Text 阶段}" TitleSize="14" Padding="18,12,18,6" />

      <Border Grid.Row="5" Margin="18,0,18,0" Style="{StaticResource PickerListBorder}">
        <ItemsControl ItemsSource="{Binding Stages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource PickerRowButton}" IsEnabled="False">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Bar" Grid.Column="0" Width="4" Margin="-10,0,0,0" HorizontalAlignment="Left"
                          Background="{StaticResource Brush.Accent}" Visibility="Collapsed" />
                  <TextBlock x:Name="Ico" Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}"
                             FontSize="15" Foreground="#FFA0A0A0" Text="&#xE739;" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal"
                             Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Detail}" />
                  <TextBlock x:Name="Badge" Grid.Column="3" VerticalAlignment="Center" FontWeight="Normal"
                             Foreground="{StaticResource Brush.StateOff}" Text="{loc:Text 待执行}" />
                </Grid>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static ldc:LaunchStageState.Completed}">
                  <Setter TargetName="Ico" Property="Text" Value="&#xE73E;" />
                  <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Brush.StateOk}" />
                  <Setter TargetName="Badge" Property="Text" Value="{loc:Text 完成}" />
                  <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateOk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static ldc:LaunchStageState.Running}">
                  <Setter TargetName="Ico" Property="Text" Value="&#xE896;" />
                  <Setter TargetName="Ico" Property="Foreground" Value="#FF333333" />
                  <Setter TargetName="Badge" Property="Text" Value="{loc:Text 进行中}" />
                  <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <!-- 卡在哪一步要看得见：停在"待执行"的列表看起来像"什么都没发生"。 -->
                <DataTrigger Binding="{Binding State}" Value="{x:Static ldc:LaunchStageState.Failed}">
                  <Setter TargetName="Ico" Property="Text" Value="&#xE7BA;" />
                  <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Brush.StateWarn}" />
                  <Setter TargetName="Badge" Property="Text" Value="{loc:Text 失败}" />
                  <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource ActionBarDocked}">
      <!-- 取消启动：M4-d 起真的中止会话（取消 + Job Object 回收进程树），不再只是跳回上一页。 -->
      <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消启动}" HorizontalAlignment="Right"
                    IsEnabled="{Binding IsBusy}"
                    Command="{Binding CancelCommand}" />
    </Border>
  </Grid>
</UserControl>
