<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P15AccountLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             xmlns:au="clr-namespace:EiTRVO.Core.Auth;assembly=EiTRVO.Core.Auth"
             Background="{StaticResource Brush.White}">

  <!--
    p15 添加 Microsoft 账户。对应 mockup/pages/p15-dialog-account-login.html。
    页面内容：已有账户列表 + 离线登录输入 + 贴底动作条。
    中间的设备代码流对话框（链接 + 用户代码 + 等待授权）由外壳作为模态层承载，
    所以遮罩能盖住整个窗口，与设计稿一致。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0" Icon="&#xE77B;" Title="{Binding SectionTitle}" Subtitle="{Binding SectionSubtitle}" />

      <c:SectionHeader Grid.Row="1" Icon="&#xE77B;" Title="{loc:Text 已有账户}" TitleSize="14" Padding="18,0,18,6" />

      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,0,18,0" MaxHeight="80" Style="{StaticResource PickerListBorder}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PickerRowButton}" IsEnabled="False">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Bar" Grid.Column="0" Width="4" Margin="-10,0,0,0" HorizontalAlignment="Left"
                              Background="{StaticResource Brush.Accent}" Visibility="Collapsed" />
                      <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}"
                                 FontSize="15" Foreground="#FF333333" Text="&#xE77B;" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PlayerName}" />
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal"
                                 Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Meta}" />
                      <TextBlock x:Name="Badge" Grid.Column="3" VerticalAlignment="Center" FontWeight="Normal"
                                 Foreground="{StaticResource Brush.StateOk}" Text="{loc:Text 令牌有效}" />
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static au:AccountKind.Offline}">
                      <Setter TargetName="Badge" Property="Text" Value="{loc:Text 仅离线}" />
                      <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateOff}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,0" MinHeight="{StaticResource Size.PropRowHeight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 离线登录}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBox Width="200" Text="{Binding OfflinePlayerName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{StaticResource Brush.TextMuted}" Text="{loc:Text 仅用于单机与离线服}"
                       Visibility="{Binding OfflineError, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{StaticResource Brush.StateErr}" Text="{Binding OfflineError}"
                       Visibility="{Binding OfflineError, Converter={StaticResource EmptyToCollapsed}}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource ActionBarDocked}">
      <c:IconButton Icon="&#xE77B;"
                    Text="{loc:Text 以离线模式登录}"
                    HorizontalAlignment="Left"
                    Command="{Binding AddOfflineCommand}" />
    </Border>
  </Grid>
</UserControl>
