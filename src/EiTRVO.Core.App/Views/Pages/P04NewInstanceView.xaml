<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P04NewInstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             xmlns:lvc="clr-namespace:EiTRVO.Core.Launcher.Versions;assembly=EiTRVO.Core.Launcher"
             Background="{StaticResource Brush.White}">

  <!--
    p04 新建实例向导。对应 mockup/pages/p04-new-instance.html（图中停在第 2 步）。
    结构：区块标题 → 4 步步骤条 → 已选版本 → 加载器选择列表 → 加载器版本 / 所需 Java →
          安装体积提示条 → 动作条（上一步 / 取消 / 下一步）。
    步骤条与加载器列表都直接绑 ViewModel 的状态，不是画上去的静态图。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <c:SectionHeader Grid.Row="0"
                     Icon="&#xE710;"
                     Title="{Binding SectionTitle}"
                     Subtitle="{Binding SectionSubtitle}" />

    <!-- ==================== 步骤条 ==================== -->
    <Border Grid.Row="1" Style="{StaticResource WizardStepsBorder}">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Step"
                    Padding="12,10,12,10"
                    BorderBrush="{StaticResource Brush.Line}"
                    BorderThickness="0,0,1,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Num"
                        Width="20"
                        Height="20"
                        Background="{StaticResource Brush.ControlBackground}"
                        BorderBrush="{StaticResource Brush.ControlBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                  <TextBlock x:Name="NumText"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="#FF555555"
                             Text="{Binding Number}" />
                </Border>
                <TextBlock x:Name="Title"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}" />
                <!-- 已完成的步骤：编号仍是数字，另加一个小对勾（不把方框换成对勾，否则会丢序号） -->
                <TextBlock x:Name="Tick"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.StateOk}"
                           Text="&#xE73E;"
                           Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static lvc:WizardStepState.Done}">
                <Setter TargetName="NumText" Property="Foreground" Value="{StaticResource Brush.StateOk}" />
                <Setter TargetName="Num" Property="BorderBrush" Value="{StaticResource Brush.StateOk}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="{x:Static lvc:WizardStepState.Current}">
                <Setter TargetName="Step" Property="Background" Value="{StaticResource Brush.AccentSelected}" />
                <Setter TargetName="Num" Property="Background" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="Num" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="NumText" Property="Foreground" Value="{StaticResource Brush.White}" />
                <Setter TargetName="NumText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
              <!-- 最后一步右侧不画分隔线 -->
              <DataTrigger Binding="{Binding Number}" Value="4">
                <Setter TargetName="Step" Property="BorderThickness" Value="0" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ==================== 已选版本 ==================== -->
    <Grid Grid.Row="2" Margin="18,16,18,0" MinHeight="{StaticResource Size.PropRowHeight}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 已选版本}" />
      <TextBlock Grid.Column="1"
                 Style="{StaticResource Text.PropValue}"
                 FontWeight="SemiBold"
                 Text="{Binding SelectedVersionText}" />
    </Grid>

    <!-- ==================== 第 1 步：游戏版本（已从 p05 选定） ==================== -->
    <Border Grid.Row="3"
            Margin="18,4,18,0"
            Padding="12,10"
            Background="{StaticResource Brush.RowAlternate}"
            BorderBrush="{StaticResource Brush.RowBorder}"
            BorderThickness="1"
            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
      <TextBlock TextWrapping="Wrap"
                 Text="{loc:Text 游戏版本已从「所有版本」选定。要换版本，请回到那一页重新选择。}" />
    </Border>

    <!-- ==================== 第 3 步：名称与目录 ==================== -->
    <Grid Grid.Row="3"
          Margin="18,4,18,0"
          Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例名称}" />
      <TextBox Grid.Row="0"
               Grid.Column="1"
               Margin="0,0,8,0"
               MinWidth="320"
               Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,4,8,0"
                 Foreground="{StaticResource Brush.StateErr}"
                 TextWrapping="Wrap"
                 Text="{Binding NameError}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 创建位置}" />
      <TextBlock Grid.Row="2"
                 Grid.Column="1"
                 Style="{StaticResource Text.PropValue}"
                 Text="{Binding InstanceLocation}" />

    </Grid>

    <!-- ==================== 第 4 步：确认 ==================== -->
    <Grid Grid.Row="3"
          Margin="18,4,18,0"
          Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 游戏版本}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding SelectedVersionText}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 模组加载器}" />
      <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding SelectedLoader.Display}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例名称}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding InstanceName}" />
    </Grid>
    <!-- ==================== 加载器选择 ==================== -->
    <Border Grid.Row="3"
            Margin="18,4,18,0"
            Style="{StaticResource PickerListBorder}"
            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding Loaders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource PickerRowButton}"
                    IsEnabled="{Binding IsSelectable}"
                    Command="{Binding DataContext.SelectLoaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
<TextBlock x:Name="Ico"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="15"
                           Foreground="#FF333333"
                           Text="&#xE7FC;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Display}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="Normal"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Detail}" />
                <TextBlock x:Name="Badge"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           FontWeight="Normal"
                           Foreground="{StaticResource Brush.Accent}"
                           Text="{loc:Text 选择}" />
              </Grid>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Ico" Property="Text" Value="&#xE73E;" />
                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Brush.StateOk}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Availability}" Value="{x:Static lvc:LoaderAvailability.Recommended}">
                <Setter TargetName="Badge" Property="Text" Value="{loc:Text 已选择}" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateOk}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Availability}" Value="{x:Static lvc:LoaderAvailability.Failed}">
                <Setter TargetName="Badge" Property="Text" Value="{loc:Text 重试}" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateErr}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Availability}" Value="{x:Static lvc:LoaderAvailability.Unavailable}">
                <Setter TargetName="Badge" Property="Text" Value="{loc:Text 不可用}" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateOff}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Availability}" Value="{x:Static lvc:LoaderAvailability.Discouraged}">
                <Setter TargetName="Badge" Property="Text" Value="{loc:Text 不推荐用于整合包}" />
                <Setter TargetName="Badge" Property="Foreground" Value="{StaticResource Brush.StateOff}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ==================== 加载器版本 / 所需 Java ==================== -->
    <Grid Grid.Row="4" Margin="18,16,18,0" MinHeight="{StaticResource Size.PropRowHeight}"
          Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      
        <Border Grid.Row="0" Grid.RowSpan="1" Grid.Column="2" Style="{StaticResource PropsDivider}" />
      
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 加载器版本}" />
      <ComboBox Grid.Row="0" Grid.Column="1"
                Margin="0,0,8,0"
                MinWidth="200"
                ItemsSource="{Binding LoaderVersionOptions}"
                ItemTemplate="{StaticResource ChoiceOptionText}"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedLoaderVersion, Mode=TwoWay}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 所需 Java}" />
      <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding RequiredJavaText}" />

      <!-- 2026-10-24：可选组件（参考 Neo）——Forge 可同时放 OptiFine，Fabric 可同时装 Fabric API。 -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
        <CheckBox Content="{loc:Text 同时安装 OptiFine（Forge 共存）}"
                  IsChecked="{Binding WithOptiFine, Mode=TwoWay}"
                  Visibility="{Binding ShowOptiFineComponent, Converter={StaticResource BoolToVisibility}}" />
        <!-- 只有 OptiFine 也显示时才保留 24dip 间隔；否则 Fabric API 会带着左边距、
             在隐藏的 OptiFine 后面留下空白。 -->
        <Border Width="24"
                Height="1"
                Visibility="{Binding ShowOptiFineComponent, Converter={StaticResource BoolToVisibility}}" />
        <CheckBox Content="{loc:Text 同时安装 Fabric API}"
                  IsChecked="{Binding WithFabricApi, Mode=TwoWay}"
                  Visibility="{Binding ShowFabricApiComponent, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Grid>

    <!-- ==================== 安装体积提示 ==================== -->
    <c:Banner Grid.Row="5" Margin="18,14,18,0" Icon="&#xE946;"
              Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
      <TextBlock TextWrapping="Wrap" LineHeight="20">
        <Run Text="{loc:Text 安装将下载约}" /><Run FontWeight="SemiBold" Text="{Binding DownloadSizeText, Mode=OneWay}" /><Run Text="{Binding DownloadBreakdownText, Mode=OneWay}" />
        <LineBreak /><Run Text="{Binding DiskFreeText, Mode=OneWay}" />
      </TextBlock>
    </c:Banner>
    <c:Banner Grid.Row="5" Margin="18,14,18,0" Icon="&#xE7BA;"
              Visibility="{Binding ShowDownloadLockHint, Converter={StaticResource BoolToVisibility}}">
      <TextBlock TextWrapping="Wrap" Text="{Binding DownloadActionHint}" />
    </c:Banner>

    <!-- ==================== 动作条 ==================== -->
    <Border Grid.Row="7" Style="{StaticResource ActionBarDocked}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:IconButton Grid.Column="0"
                      Icon="&#xE72B;"
                      Text="{loc:Text 上一步}"
                      HorizontalAlignment="Left"
                      Command="{Binding BackCommand}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;"
                        Text="{loc:Text 取消}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:PageId.Instances}" />
          <!--
            最后一步换成「确认并安装」（设计稿第 4 步的名字）。两个按钮位置与尺寸相同、
            互斥显示：走到最后一步时才出现创建动作，之前的步骤里它根本不存在。
          -->
          <c:IconButton Icon="&#xE72A;"
                        Text="{loc:Text 下一步}"
                        Margin="10,0,0,0"
                        Style="{StaticResource IconButton.PrimaryCompact}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}"
                        Command="{Binding NextCommand}" />
          <c:IconButton Icon="&#xE896;"
                        Text="{loc:Text 确认并安装}"
                        Margin="10,0,0,0"
                        Style="{StaticResource IconButton.PrimaryCompact}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding FinishCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
