<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Pages.P17InstanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             Background="{StaticResource Brush.White}">

  <!--
    p17 实例设置（逐实例）。对应 mockup/pages/p17-instance-settings.html。
    结构：区块标题 → 实例属性 → 1px 分隔线 → Java 运行时 → 内存分配 →
          游戏窗口与启动 → 覆盖说明条 → 1px 分隔线 → 配置变更记录 → 贴底动作条。
    未覆盖的项继承全局默认（p10），所以这里有「重置为全局默认」与「全局默认值」两个出口。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 内容区可滚动：窗口高度不足时（最小 620）属性表不该被直接切掉一截 -->
    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0" Icon="&#xE713;" Title="{Binding SectionTitle}" Subtitle="{Binding SectionSubtitle}" />

      <!-- 实例属性：4 等分 -->
      <Grid Grid.Row="1" Style="{StaticResource PropsBox}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource PropsDivider}" />

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例名称}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.Name}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 游戏版本}" />
        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.GameVersion}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 模组加载器}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LoaderDisplay}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 隔离目录}" />
        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Text.PropValue}"
                   Foreground="{StaticResource Brush.StateOk}" Text="{Binding Detail.IsolatedDirectoryText}" />
      </Grid>

      <!-- 实例路径等：92px / 1fr 两对 -->
      <Grid Grid.Row="2" Margin="18,0,18,6" MinHeight="{StaticResource Size.PropRowHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource PropsDivider}" />

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例路径}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" TextTrimming="CharacterEllipsis" Text="{Binding Detail.InstancePath}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 占用空间}" />
        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.SizeOnDisk}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 累计游玩时长}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.PlayTime}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 最后退出码}" />
        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Text.PropValue}"
                   Foreground="{Binding Detail.LastExitCodeTone, Converter={StaticResource ToneBrush}}"
                   Text="{Binding Detail.LastExitCodeText}" />
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource HairLine}" />

      <c:SectionHeader Grid.Row="4" Icon="&#xE9D9;" Title="{loc:Text Java 运行时}" Subtitle="{loc:Text 未覆盖时继承全局默认}"
                       TitleSize="14" Padding="18,12,18,6" />

      <Grid Grid.Row="5" Margin="18,0,18,0" MinHeight="{StaticResource Size.PropRowHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例覆盖}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox MinWidth="0" ItemsSource="{Binding JavaOverrideOptions}"
                    ItemTemplate="{StaticResource ChoiceOptionText}"
                    SelectedValuePath="Value" SelectedValue="{Binding JavaOverride, Mode=TwoWay}"
                    ToolTip="{loc:Text 留空则继承全局默认；全局默认在「Java 与设置」页修改。}" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                     Foreground="{StaticResource Brush.TextMuted}" Text="{Binding RequiredJavaHint}" />
        </StackPanel>
      </Grid>

      <c:SectionHeader Grid.Row="6" Icon="&#xE9D2;" Title="{loc:Text 内存分配}" TitleSize="14" Padding="18,8,18,6" />

      <Grid Grid.Row="7" Margin="18,0,18,0" MinHeight="{StaticResource Size.PropRowHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 最大内存 (Xmx)}" />
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,2">
          <StackPanel Orientation="Horizontal">
            <Slider Width="260" Minimum="1024" Maximum="16384" TickFrequency="512"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Value="{Binding MaxMemoryMb, Mode=TwoWay}" />
            <TextBox MinWidth="0" Width="90" Margin="12,0,0,0" Text="{Binding MaxMemoryMb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="MB" />
          </StackPanel>
          <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.SmallMuted}" Text="{Binding MemoryHint}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text JVM 参数}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <TextBox MinWidth="0" Text="{Binding JvmArguments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                     Foreground="{StaticResource Brush.TextMuted}" Text="{loc:Text 留空则继承全局}" />
        </StackPanel>
      </Grid>

      <c:SectionHeader Grid.Row="8" Icon="&#xE7C4;" Title="{loc:Text 游戏窗口与启动}" TitleSize="14" Padding="18,8,18,6" />

      <Grid Grid.Row="9" Margin="18,0,18,0" MinHeight="{StaticResource Size.PropRowHeight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
          <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource PropsDivider}" />

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 窗口尺寸}" />
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" Orientation="Horizontal">
          <TextBox MinWidth="0" Width="70" Text="{Binding WindowWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Margin="6,0,6,0" VerticalAlignment="Center" Text="×" />
          <TextBox MinWidth="0" Width="70" Text="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 启动方式}" />
        <ComboBox Grid.Row="0" Grid.Column="3" MinWidth="140" HorizontalAlignment="Left"
                  ItemsSource="{Binding LaunchModeOptions}" ItemTemplate="{StaticResource ChoiceOptionText}"
                  SelectedValuePath="Value" SelectedValue="{Binding LaunchMode, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 附加参数}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" MinWidth="0"
                 Text="{Binding ExtraGameArguments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 启动后行为}" />
        <CheckBox Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"
                  IsChecked="{Binding MinimizeAfterLaunch, Mode=TwoWay}" Content="{loc:Text 最小化启动器}" />
      </Grid>

      <c:Banner Grid.Row="10" Icon="&#xE946;" Margin="18,12,18,0">
        <TextBlock TextWrapping="Wrap" LineHeight="20">
          <Run Text="{loc:Text 带}" /><Run FontWeight="SemiBold" Text="{loc:Text 实例覆盖}" /><Run Text="{loc:Text 的项仅作用于本实例；其余项继承}" /><Run FontWeight="SemiBold" Text="{loc:Text 全局设置}" /><Run Text="{loc:Text 。全局值可在「Java 与设置」页修改。}" />
        </TextBlock>
      </c:Banner>

      <Border Grid.Row="11" Style="{StaticResource HairLine}" />

      <Grid Grid.Row="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:SectionHeader Grid.Row="0" Icon="&#xE9D5;" Title="{loc:Text 事件}" Padding="18,0,18,6" />

        <TextBlock Grid.Row="1" Margin="18,0,18,4" Text="{Binding ChangeCountText}" />

        <DataGrid Grid.Row="2" Height="120" Margin="18,0,18,12" ItemsSource="{Binding ChangeEvents}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="48" Header="ID" Binding="{Binding Id}" />
            <DataGridTemplateColumn Width="64" Header="{loc:Text 级别}" CellTemplate="{StaticResource EventLevelCell}" />
            <DataGridTextColumn Width="*" Header="{loc:Text 消息}" Binding="{Binding Message}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Message}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Width="130" Header="{loc:Text 时间}" Binding="{Binding Time}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" Style="{StaticResource ActionBarDocked}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <c:IconButton Icon="&#xE713;" Text="{loc:Text 全局默认值}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:PageId.JavaSettings}" />
          <c:IconButton Icon="&#xE9F9;" Text="{loc:Text 重置为全局默认}" Margin="10,0,0,0" Command="{Binding ResetToGlobalCommand}" />
          <c:IconButton Icon="&#xE72B;" Text="{loc:Text 返回实例详情}" Margin="10,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:PageId.InstanceDetail}" />
        </WrapPanel>
        <c:IconButton Grid.Column="1" Icon="&#xE73E;" Text="{loc:Text 保存设置}" HorizontalAlignment="Right"
                      Style="{StaticResource IconButton.PrimaryCompact}" Command="{Binding SaveCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
