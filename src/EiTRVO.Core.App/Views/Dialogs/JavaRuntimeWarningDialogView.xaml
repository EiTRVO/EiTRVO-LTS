<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
        x:Class="EiTRVO.Core.App.Views.Dialogs.JavaRuntimeWarningDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <Border Width="520"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{loc:Text Java 运行时安全提示}" />
      </Border>

      <Grid Grid.Row="1" Margin="18,16,18,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top"
                   FontFamily="{StaticResource Font.Icon}" FontSize="28"
                   Foreground="{StaticResource Brush.StateWarn}" Text="&#xE7BA;" />

        <StackPanel Grid.Column="1">
          <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="{loc:Text 这个 Java 运行时可能存在风险}" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22"
                     Foreground="{StaticResource Brush.TextMuted}" Text="{Binding RiskText}" />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                     Foreground="{StaticResource Brush.TextMuted}" Text="{Binding FilePath}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消}" Command="{Binding CancelCommand}" />
          <c:IconButton Icon="&#xE710;" Text="{loc:Text 仍然添加}" Margin="8,0,0,0"
                        Command="{Binding AcceptCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
