<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Dialogs.RenameInstanceDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <!-- 重命名实例对话框：与删除确认框 / 离线账户框同一套 modal 规格。 -->
  <Border Width="460"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{loc:Text 重命名实例 — EiTRVO For Preview}" />
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16,18,16">
        <TextBlock TextWrapping="Wrap" LineHeight="22"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{loc:Text 只修改实例目录名，实例内的游戏文件、模组与存档都保留；正在运行的游戏不会被改名。}" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例名称}" />
          <TextBox Grid.Column="1" MaxLength="64"
                   Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Margin="86,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.StateErr}" Text="{Binding Error}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <Border Grid.Row="2"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消}" Command="{Binding CancelCommand}" />
          <c:IconButton Icon="&#xE70F;" Text="{loc:Text 重命名}" Margin="8,0,0,0"
                        Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
