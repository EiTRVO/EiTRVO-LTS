<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Dialogs.OfflineAccountDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <!--
    离线账户对话框（p11 的独立入口）。外壳 `.modal` 的规格：460px 宽、直角、1px 边、
    深色 31px 标题条、底部 1px 分隔线与右对齐按钮 —— 与「删除实例」确认框同一套。
    内容只有两件东西：玩家名（唯一一项数据）与它下面那行提示/错误，
    所以不铺 props 网格，也不用一个"看起来像属性表"的布局去凑。
  -->
  <Border Width="460"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{loc:Text 离线账户 — EiTRVO For Preview}" />
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16,18,16">
        <TextBlock TextWrapping="Wrap" LineHeight="22"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{loc:Text 离线账户不经过 Xbox 服务器：只有玩家名，UUID 由名字派生。}" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 玩家名称}" />
          <TextBox Grid.Column="1" MaxLength="16"
                   Text="{Binding PlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 提示位：正常显示规则，出错时同一位置换成原因（不新增控件，与 p11 原来的做法一致） -->
        <TextBlock Margin="86,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextMuted}" Text="{loc:Text 仅用于单机与离线服}"
                   Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}" />
        <TextBlock Margin="86,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.StateErr}" Text="{Binding Error}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <Border Grid.Row="2"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消}" Command="{Binding CancelCommand}" />
          <c:IconButton Icon="&#xE710;" Text="{loc:Text 添加}" Margin="8,0,0,0" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
