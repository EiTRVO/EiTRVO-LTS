<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Dialogs.AddAccountDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <!--
    添加 Microsoft 账户对话框。对应 mockup/pages/p15-dialog-account-login.html 的 .modal（520px 宽）。
    两步：① 在浏览器打开链接；② 输入用户代码。等待授权状态在最下方。
    全程没有任何输入密码的控件 —— 这是 AGENTS.md §6 的硬性要求。
  -->
  <Border Width="520"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{loc:Text 添加 Microsoft 账户}" />
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16,18,16">
        <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="22"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{loc:Text 登录将使用 Microsoft 设备代码流。}" />

        <Border Background="{StaticResource Brush.BannerBackground}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                Padding="16,14,16,14">
          <StackPanel>
            <TextBlock Text="{loc:Text 第 1 步：在浏览器打开}" />
            <!--
              链接那一行**必须是 Grid**：文本列 `*`（按需截断并带完整值的 ToolTip）+ 两个按钮列 `Auto`。
              2026-10-06 用户反馈（Bug3.png）：原来这里是水平 StackPanel —— 文本按自身宽度占位、
              按钮没有伸缩余地，于是「用系统浏览器打开」被裁掉一截（与 2026-10-04 动作条那个
              "Open mods directory 只剩 Open m" 是同一类错误，见 AGENTS.md §5.3）。
            -->
            <Grid Margin="0,10,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource Brush.Accent}"
                         ToolTip="{Binding Session.VerificationUrl}"
                         Text="{Binding LinkText}" />
              <c:IconButton Grid.Column="1" Icon="&#xE8C8;" Text="{loc:Text 复制链接}" Margin="10,0,0,0"
                            Command="{Binding CopyLinkCommand}" />
              <c:IconButton Grid.Column="2" Icon="&#xE8A7;" Text="{loc:Text 用系统浏览器打开}" Margin="8,0,0,0"
                            Command="{Binding OpenLinkCommand}" />
            </Grid>

            <TextBlock Margin="0,0,0,8" Text="{loc:Text 第 2 步：输入以下代码}" />
            <!-- 同一条规矩：用户代码不能被截断（它就是用户要照着输入的东西），
                 所以代码列是 `*`、按钮列是 `Auto`。 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" VerticalAlignment="Center"
                         FontFamily="{StaticResource Font.Mono}" FontSize="26" FontWeight="Bold"
                         Text="{Binding Session.UserCode}" />
              <c:IconButton Grid.Column="1" Icon="&#xE8C8;" Text="{loc:Text 复制代码}" Margin="14,0,0,0"
                            Command="{Binding CopyCodeCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}"
                     Foreground="{StaticResource Brush.Accent}" Text="&#xE895;" />
          <!--
            失败原因也走这一行（设计稿只有一个内联提示位，为它新增控件属于改设计）。
            因此这里允许折行：M5-1 起这一行的内容可能是"这个账户还没有 Xbox 档案，请先在 Xbox 官网创建…"
            这类较长的句子，不折行就会被裁掉一半 —— 被裁掉的恰好是要用户去做的那件事。
          -->
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}" Text="{Binding WaitingText}" />
        </StackPanel>
      </StackPanel>

      <Border Grid.Row="2"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消}" Command="{Binding CancelCommand}" />
          <!-- 等待状态由后台轮询推进，所以这个按钮在界面上始终是禁用态 -->
          <c:IconButton Icon="&#xE73E;"
                        Text="{loc:Text 我已在浏览器完成授权}"
                        Margin="8,0,0,0"
                        IsEnabled="False" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
