<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Dialogs.RemoveAccountDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <!--
    移除账户确认框（p11 的模态层）。外壳 `.modal` 的规格与「删除实例」确认框同一套：
    460px 宽、直角、1px 边、深色 31px 标题条、底部 1px 分隔线 + 右对齐按钮。
    按钮带左侧图标：这个 App 里所有动作按钮都有字形（入口按钮、动作条按钮），
    只有模态层以前是纯文字 —— 用户点出这一条，所以这里补上（取消 E711 / 移除 E74D）。
  -->
  <Border Width="460"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{loc:Text 移除账户}" />
      </Border>

      <Grid Grid.Row="1" Margin="18,16,18,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top"
                   FontFamily="{StaticResource Font.Icon}" FontSize="28"
                   Foreground="{StaticResource Brush.StateWarn}" Text="&#xE7BA;" />

        <StackPanel Grid.Column="1">
          <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Question}" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Text="{loc:Text 将删除本机保存的登录信息}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="22"
                     Foreground="{StaticResource Brush.StateErr}" Text="{Binding Error}"
                     Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <c:IconButton Icon="&#xE711;" Text="{loc:Text 取消}" Command="{Binding CancelCommand}" />
          <c:IconButton Icon="&#xE74D;" Text="{loc:Text 移除账户}" Margin="8,0,0,0"
                        Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
