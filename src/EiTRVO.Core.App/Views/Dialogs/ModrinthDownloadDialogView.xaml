<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Dialogs.ModrinthDownloadDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <!--
    「从 Modrinth 下载」对话框（p07 模组 / p09 资源包共用）。
    遮罩由外壳绘制（见 MainWindow）；这里只有 760px 的卡片。
  -->
  <Border Width="760"
          Background="{StaticResource Brush.White}"
          BorderBrush="{StaticResource Brush.DialogBorder}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="31" Background="{StaticResource Brush.PageHeadGradient}">
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}" Text="{Binding Title}" />
      </Border>

      <Grid Grid.Row="1" Margin="18,14,18,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Margin="0,0,8,0"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <c:IconButton Grid.Column="1" Icon="&#xE721;"
                      Text="{loc:Text 搜索}"
                      Command="{Binding SearchCommand}" />
      </Grid>

      <DataGrid Grid.Row="2"
                Margin="18,0,18,0"
                MaxHeight="300"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                ItemsSource="{Binding Entries}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="180" Header="{loc:Text 名称}" Binding="{Binding Name}" />
          <DataGridTextColumn Width="*" Header="{loc:Text 简介}" Binding="{Binding Summary}" />
          <DataGridTextColumn Width="90" Header="{loc:Text 下载量}" Binding="{Binding Downloads}" />
          <DataGridTextColumn Width="90" Header="{loc:Text 版本}" Binding="{Binding Version}" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Row="3"
                 Margin="18,8,18,0"
                 Foreground="{StaticResource Brush.StateErr}"
                 TextWrapping="Wrap"
                 Text="{Binding Error}"
                 Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />

      <Border Grid.Row="4"
              Padding="18,12,18,12"
              BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource Brush.TextMuted}"
                     Text="{loc:Text 按当前实例的游戏版本与加载器挑选兼容版本；下载会排进「下载与队列」。}" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <c:IconButton Text="{loc:Text 取消}" Icon="&#xE711;" Command="{Binding CloseCommand}" />
            <c:IconButton Text="{loc:Text 下载所选}" Margin="8,0,0,0"
                          Icon="&#xE896;"
                          Command="{Binding DownloadCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
