<UserControl
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
         x:Class="EiTRVO.Core.App.Views.Parts.InstanceOverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
             xmlns:vm="clr-namespace:EiTRVO.Core.App.ViewModels"
             Background="{StaticResource Brush.White}">

  <!--
    「实例属性」面板：p03 实例详情与 p13 删除实例共用同一块内容。

    设计稿里 p13 的页面内容就是 p03 的内容（属性 + 实例操作 + 动作条 + 事件）加上一个模态框，
    所以这里把它抽成一个 View 片段，两个页面各自套自己的外壳，而不是把 120 行 XAML 抄两遍。

    它没有自己的 ViewModel：DataContext 由宿主页面提供，
    要求的成员是 SectionTitle / SectionSubtitle / Detail / Actions / Events /
    EventCountText / OpenGameFolderCommand —— p03 与 p13 的 ViewModel 都提供这些。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <c:SectionHeader Grid.Row="0" Icon="&#xE9D9;" Title="{Binding SectionTitle}" Subtitle="{Binding SectionSubtitle}" />

    <Grid Grid.Row="1" Style="{StaticResource PropsBox}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
        <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PropRowHeight}" />
      </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="2" Style="{StaticResource PropsDivider}" />

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 实例名称}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.Name}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 游戏版本}" />
      <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.GameVersion}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 模组加载器}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LoaderDisplay}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text Java 运行时}" />
      <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.JavaRuntime}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 游戏目录}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.GameDirectory}" />
      <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 上次启动}" />
      <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LastLaunched}" />

      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 资源校验}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.ResourceVerification}" />
      <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 账户}" />
      <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.Account}" />

      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 内存分配}" />
      <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.MemoryText}" />
      <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 实例占用空间}" />
      <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.SizeOnDisk}" />

      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 模组数量}" />
      <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.ModSummary}" />
      <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 累计游玩时长}" />
      <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.PlayTime}" />

      <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 启动次数}" />
      <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.LaunchCount}" />
      <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 最后退出码}" />
      <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource Text.PropValue}"
                 Foreground="{Binding Detail.LastExitCodeTone, Converter={StaticResource ToneBrush}}"
                 Text="{Binding Detail.LastExitCodeText}" />

      <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Text.PropLabel}" Text="{loc:Text 游戏窗口}" />
      <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.WindowMode}" />
      <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Text.PropLabelSecond}" Text="{loc:Text 隔离目录}" />
      <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource Text.PropValue}" Text="{Binding Detail.IsolatedDirectoryText}" />
    </Grid>

    <Grid Grid.Row="3" Margin="18,10,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <c:SectionHeader Grid.Row="0" Icon="&#xE8FD;" Title="{loc:Text 实例操作}" TitleSize="14" Padding="0,0,0,6" />
      <Border Grid.Row="1" Style="{StaticResource PickerListBorder}" BorderThickness="0">
        <ItemsControl ItemsSource="{Binding Actions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource PickerRowButton}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Target}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}"
                             FontSize="15" Foreground="#FF333333" Text="{Binding Icon}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Normal"
                             Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Summary}" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="Normal"
                             Foreground="{StaticResource Brush.Accent}" Text="{loc:Text 打开}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource ActionBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <c:IconButton Icon="&#xE9D9;" Text="{loc:Text 打开游戏目录}" Command="{Binding OpenGameFolderCommand}" />
          <c:IconButton Icon="&#xE90F;" Text="{loc:Text 校验文件}" Margin="10,0,0,0"
                        Command="{Binding VerifyFilesCommand}" />
          <c:IconButton Icon="&#xE74D;" Text="{loc:Text 删除实例}" Margin="10,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:PageId.DeleteInstance}" />
        </WrapPanel>
        <c:IconButton Grid.Column="1" Icon="&#xE713;" Text="{loc:Text 实例设置}" HorizontalAlignment="Right"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{x:Static vm:PageId.InstanceSettings}" />
      </Grid>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource HairLine}" />

    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <c:SectionHeader Grid.Row="0" Icon="&#xE9D5;" Title="{loc:Text 事件}" Padding="18,0,18,6" />

      <TextBlock Grid.Row="1" Margin="18,0,18,4" Text="{Binding EventCountText}" />

      <!--
        事件筛选行：设计稿画的是「筛选器 + 两个图标按钮 + 右对齐的『全部级别』」。
        2026-10-06（M6-c）：筛选器从**装饰框**换成真输入框（原来点了没反应），
        「全部级别」从一行静态文字换成真的级别下拉（静态文字看起来就是个可点的链接）。
        S9-d 起两颗图标按钮接上了：E8CB 切换排序方向、E72C 立即重读事件。
      -->
      <Grid Grid.Row="2" Style="{StaticResource FilterRow}" Margin="18,0,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource FilterBoxBorder}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icon}" FontSize="12" Text="&#xE71C;" />
            <!-- 占位文本垫在输入框下面，只在输入为空时显示（设计稿的「筛选器」是占位符） -->
            <TextBlock Grid.Column="1"
                       Margin="6,0,6,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="{loc:Text 筛选器}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EventFilterText}" Value="" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=EventFilterBox}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="EventFilterBox"
                     Grid.Column="1"
                     Margin="6,0,6,0"
                     Padding="0"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Text="{Binding EventFilterText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icon}"
                       FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="&#xE721;" />
          </Grid>
        </Border>
        <c:IconButton Grid.Column="1"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE8CB;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 切换事件排序方向}"
                      Command="{Binding ToggleEventSortCommand}" />
        <c:IconButton Grid.Column="2"
                      Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE72C;"
                      Margin="8,0,0,0"
                      ToolTip="{loc:Text 立即重读事件}"
                      Command="{Binding RefreshEventsCommand}" />
        <TextBlock Grid.Column="3"
                   Margin="12,0,12,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{Binding FilterHintText}" />
        <!-- 设计稿这里是右对齐的一行「全部级别」链接：换成真下拉（静态稿画不上下拉，用链接代指）。 -->
        <ComboBox Grid.Column="4"
                  MinWidth="0"
                  HorizontalAlignment="Right"
                  ItemsSource="{Binding EventLevelChoices}"
                  ItemTemplate="{StaticResource ChoiceOptionText}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding EventLevelChoice, Mode=TwoWay}" />
      </Grid>

      <!-- VerticalAlignment=Top：固定 120px 高的表在 `*` 行里默认会被**居中**，
           于是页面高时表格悬在半空（设计稿的事件块是"填满剩余空间、表格贴住筛选行"）。 -->
      <DataGrid Grid.Row="3" Height="120" VerticalAlignment="Top" Margin="18,8,18,12" ItemsSource="{Binding FilteredEvents}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="48" Header="ID" Binding="{Binding Id}" />
          <DataGridTemplateColumn Width="64" Header="{loc:Text 级别}" CellTemplate="{StaticResource EventLevelCell}" />
          <DataGridTemplateColumn Width="*" Header="{loc:Text 来源}" CellTemplate="{StaticResource EventSourceCell}" />
          <DataGridTextColumn Width="170" Header="{loc:Text 消息}" Binding="{Binding Message}" />
          <DataGridTextColumn Width="130" Header="{loc:Text 时间}" Binding="{Binding Time}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
