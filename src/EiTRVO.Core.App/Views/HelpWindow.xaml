<Window Icon="/icon/icon.ico"
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
        x:Class="EiTRVO.Core.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:EiTRVO.Core.App.Behaviors"
        xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
        Title="{Binding Title}"
        Width="840"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Size.BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <i:Interaction.Behaviors>
    <b:LightTitleBarBehavior />
  </i:Interaction.Behaviors>

  <!--
    2026-10-25 用户指定参考 sample4.png：
    左上角快速入门、左侧介绍区、右侧图解区、底部左侧主页 / 右侧后退出前进。
    先做布局框架，不添加图片与正文。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Margin="24,18,24,0"
               Foreground="{StaticResource Brush.TextMuted}"
               Text="{loc:Text 快速入门}" />

    <Grid Grid.Row="1" Margin="48,24,48,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="45*" />
        <ColumnDefinition Width="55*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：helpdoc/doc.docx 的说明文字（不含“步骤x”）。 -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock FontSize="30"
                   FontWeight="Light"
                   TextWrapping="Wrap"
                   Text="{Binding CurrentStepTitle}" />
        <TextBlock Margin="0,14,0,0"
                   FontSize="16"
                   FontWeight="Light"
                   LineHeight="26"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="{Binding CurrentStepBody}" />
      </StackPanel>

      <!-- 右侧：对应步骤截图。 -->
      <Border Grid.Column="1"
              Margin="24,0,0,0"
              Background="{StaticResource Brush.ControlBackground}">
        <Image Margin="8"
               Stretch="Uniform"
               Source="{Binding CurrentStepImageUri}" />
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <c:IconButton Grid.Column="0"
                    Style="{StaticResource IconButton.IconBox}"
                    Icon="&#xE80F;"
                    ToolTip="{loc:Text 主页}"
                    Command="{Binding HomeCommand}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <c:IconButton Style="{StaticResource IconButton.IconBox}"
                      Icon="&#xE72B;"
                      ToolTip="{loc:Text 后退}"
                      Command="{Binding PreviousStepCommand}" />
        <c:IconButton Style="{StaticResource IconButton.IconBox}"
                      Margin="8,0,0,0"
                      Icon="&#xE72A;"
                      ToolTip="{loc:Text 前进}"
                      Command="{Binding NextStepCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
