<Window Icon="/icon/icon.ico"
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization"
        x:Class="EiTRVO.Core.App.Views.ThirdPartyLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:EiTRVO.Core.App.Behaviors"
        xmlns:c="clr-namespace:EiTRVO.Core.App.Controls"
        Title="{Binding Title}"
        Width="880"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.White}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource Size.BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <i:Interaction.Behaviors>
    <b:LightTitleBarBehavior />
  </i:Interaction.Behaviors>

  <Window.Resources>
    <!-- 许可证正文要「从顶部开始 + 可上下滚动」；全局 TextBox 模板是单行输入（内容宿主垂直居中、
         滚动条隐藏），直接套在只读多行文本上会把正文顶到中间。 -->
    <Style x:Key="LicenseTextBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AcceptsReturn" Value="True" />
      <!-- 许可证正文按窗口宽度换行：横向滚动条在项目规范里一律禁用。 -->
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{StaticResource Brush.White}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            VerticalAlignment="Stretch"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <c:SectionHeader Grid.Row="0"
                     Icon="&#xE8A7;"
                     Title="{Binding Title}" />

    <Grid Grid.Row="1" Margin="18,4,18,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PickerListBorder}">
        <ListBox ItemsSource="{Binding Components}"
                 SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource PickerRowItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8,4,8,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="{StaticResource Size.SmallFont}">
                  <Run Text="{Binding Version, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding License, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Brush.Line}" />

      <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="12,10,12,8">
            <TextBlock Text="{Binding SelectedComponent.Name}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="{Binding SelectedMetadata}" />
          </StackPanel>

          <TextBox Grid.Row="1"
                   Margin="1,0,1,1"
                   VerticalAlignment="Stretch"
                   Style="{StaticResource LicenseTextBox}"
                   Text="{Binding SelectedLicenseText, Mode=OneWay}" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource ActionBarDocked}">
      <c:IconButton Icon="&#xE711;" Text="{loc:Text 关闭}"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}" />
    </Border>
  </Grid>
</Window>
