<!--
  Sections.xaml — 区块标题与提示条。

  · .section-head        20px 半粗标题 + 左侧 14px 语义图标（原图是 14px 灰方块）+ 副标题 + 右侧工具区
  · .banner              1px 细线框 + 浅底 + 左侧图标，可选右侧操作按钮
-->
<ResourceDictionary
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:EiTRVO.Core.App.Controls">

  <Style TargetType="{x:Type c:SectionHeader}">
    <Setter Property="Padding" Value="18,14,18,10" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:SectionHeader}">
          <Grid Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 语义图标（有图标时）。
                 负外边距是**必需**的（2026-10-06 实机反馈：模组管理 / 资源包 / 整合包 / Java 与设置 / 账户
                 等页面的区块图标被裁掉左右各一小条）：这一格的宽度是设计稿规定的 14px（原图那个灰方块），
                 而图标字号是 16px —— TextBlock 会被**测量成 14px 宽并把超出的字形裁掉**。
                 左右各 -4 让它的实测宽度变成 14+8=22px（够 16px 的字形，且在各种 DPI 下都留有余量），
                 居中仍然对齐原来的 14px 格子，标题的 x 坐标一个字都不动。 -->
            <TextBlock x:Name="Glyph"
                       Grid.Column="0"
                       Margin="-4,0,-4,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Icon}"
                       FontSize="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{StaticResource Brush.SectionGlyph}"
                       Text="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}">
              <!-- 2026-10-24 用户反馈：图标比标题的墨迹高约 4px（150% 下实测：图标中心 159.5、标题 163.5）。
                   字形在行盒里的竖向位置与标题字体不同，靠 VerticalAlignment=Center 只对齐行盒、不对齐墨迹；
                   这里只平移墨迹，不改布局与标题的 x 坐标。 -->
              <TextBlock.RenderTransform>
                <TranslateTransform Y="2.5" />
              </TextBlock.RenderTransform>
            </TextBlock>

            <!-- 无图标时回退为原图的 14×14 灰色方块 -->
            <Border x:Name="Square"
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.SectionSquare}"
                    Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisible}}" />

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
              <TextBlock VerticalAlignment="Center"
                         FontSize="{Binding TitleSize, RelativeSource={RelativeSource TemplatedParent}}"
                         FontWeight="SemiBold"
                         Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
              <!-- 副标题与**标题共用一条基线**（2026-10-06 实机反馈："标题有点低，和旁边的小字号文字不协调"）：
                   两者都居中时，WPF 居中的是**行盒**而不是基线，而 20px 中文的行盒比 12px 高得多 ——
                   实测副标题的底边比标题高 6px（150% 缩放，= 4 dip）。改成 Bottom + 1dip 下外边距后，
                   逐像素量下来两者基线相差 0～1px（那 1dip 是两种字号的 descent 之差）。
                   （设计稿 shell.css 写的是 `align-items:center`，它自己也有 5px 的同样偏移；这一条是
                   **有意优于设计稿**的排版修正，已登记在 README §5 第 38 条。） -->
              <TextBlock x:Name="Sub"
                         Margin="6,0,0,1"
                         VerticalAlignment="Bottom"
                         Foreground="{StaticResource Brush.TextMuted}"
                         Text="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>

            <!-- 右侧工具区（可以有多个子级） -->
            <ItemsPresenter Grid.Column="2" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type c:Banner}">
    <Setter Property="Margin" Value="18,0,18,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:Banner}">
          <Border x:Name="Bd"
                  Background="{StaticResource Brush.BannerBackground}"
                  BorderBrush="{StaticResource Brush.BannerBorder}"
                  BorderThickness="1"
                  Padding="10,8,10,8"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Width="16"
                         Margin="0,0,8,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         FontFamily="{StaticResource Font.Icon}"
                         FontSize="14"
                         Text="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />

              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />

              <ContentPresenter Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding Extra, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tone" Value="Warning">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.BannerWarnBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BannerWarnBorder}" />
            </Trigger>
            <Trigger Property="Tone" Value="Error">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.BannerErrorBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BannerErrorBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
