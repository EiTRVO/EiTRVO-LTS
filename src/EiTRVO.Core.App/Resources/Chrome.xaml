<!--
  Chrome.xaml — 窗口外壳与页面骨架的样式。

  · .menubar        22px 高 / #f0f0f0 / 底部 1px #e3e3e3
  · .pagehead       50px 高 / #2b2b2b / 面包屑 + 右侧四按钮
  · .sidenav        210px 宽 / 白底 / 右侧 1px #e6e6e6
  · .nav-item       32px 高 / 悬停 #eaf3fb / 选中 #cce8ff + 4px 主色左竖条 + 加粗
  · .nav-group      11px 加粗 + 上方 1px #ececec
  · .actionbar      上方 1px 分隔线；docked 版本贴窗口底部
  · hr.sep          1px 分隔线（两边各留 18px）
-->
<ResourceDictionary
        xmlns:loc="clr-namespace:EiTRVO.Core.App.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== 深色页头 ==================== -->
  <!-- 底色是横向蓝渐变（2026-10-06，见 Theme.xaml 的说明与 README §5 第 37 条）；
       忙碌时还有一道扫光，画在 MainWindow.xaml 的页头里。 -->
  <Style x:Key="PageHeadBorder" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Size.PageHeadHeight}" />
    <Setter Property="Background" Value="{StaticResource Brush.PageHeadGradient}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- 页头里四个工具之间的竖分隔线（| 分隔）：深蓝底上用半透明白 -->
  <Style x:Key="ToolSeparator" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0,6,0" />
    <Setter Property="Background" Value="{StaticResource Brush.PageHeadDivider}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== 左导航 ==================== -->
  <Style x:Key="SideNavBorder" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource Size.NavWidth}" />
    <Setter Property="Background" Value="{StaticResource Brush.White}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="NavItemButton" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0,12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Size.BodyFont}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="Transparent"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <!-- 选中态：左侧 4px 主色竖条（.nav-item.active::before） -->
              <Border x:Name="Bar"
                      Width="4"
                      Margin="-12,0,0,0"
                      HorizontalAlignment="Left"
                      Background="{StaticResource Brush.Accent}"
                      Visibility="Collapsed" />
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSelected}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavGroupBorder" TargetType="Border">
    <Setter Property="Margin" Value="12,14,12,6" />
    <Setter Property="Padding" Value="0,12,0,0" />
    <Setter Property="BorderBrush" Value="#FFECECEC" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="NavGroupText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FF333333" />
  </Style>

  <!-- ==================== 动作条 ==================== -->
  <!-- .actionbar（内容流内）：上方 1px 线 + 14px 上间距 + 18px 左右内边距 -->
  <Style x:Key="ActionBar" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Margin" Value="0,14,0,0" />
    <Setter Property="Padding" Value="18,12,18,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- .actionbar.docked（贴底）：不再需要上间距，左右下各 18/10 -->
  <Style x:Key="ActionBarDocked" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{StaticResource Brush.White}" />
    <Setter Property="Padding" Value="18,10,18,10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== 面包屑可点层级 ==================== -->
  <!-- 深色页头上的面包屑链接：细体白字，悬停 #3f3f3f 底衬（规范 §6.3 的唯一返回入口） -->
  <Style x:Key="CrumbLinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.PageHeadForeground}" />
    <Setter Property="FontSize" Value="{StaticResource Size.SectionTitleFont}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <!-- 这里**不能**用裸 ContentPresenter（2026-10-06 实机反馈："多级面包屑里第一段比第二段小一号"）：
                 字符串内容会被 ContentPresenter 生成一个内部 TextBlock，而 Text.xaml 里有**隐式** TextBlock 样式
                 （显式设了 FontSize=BodyFont=12）—— **显式样式胜过属性继承**，于是 Button 自己的 FontSize=20
                 根本到不了那段文字上。实测：可点的那一段是 12dip（墨迹高 17px）、当前段是 20dip（29px），
                 基线还差 8px。改成显式 TextBlock 拿 Text.Crumb 样式即可（显式样式压过隐式样式）。 -->
            <TextBlock Style="{StaticResource Text.Crumb}"
                       VerticalAlignment="Center"
                       Text="{TemplateBinding Content}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PageHeadHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 1px 分隔线（hr.sep） ==================== -->
  <Style x:Key="HairLine" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="18,14,18,0" />
    <Setter Property="Background" Value="{StaticResource Brush.Line}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== 属性表中间的 1px 竖分隔线 ==================== -->
  <Style x:Key="PropsDivider" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{StaticResource Brush.Divider}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- 属性表容器（.props{padding:0 18px 6px}） -->
  <Style x:Key="PropsBox" TargetType="Grid">
    <Setter Property="Margin" Value="18,0,18,6" />
  </Style>

  <!-- ==================== 筛选行 ==================== -->
  <!-- .filterrow{padding:8px 18px} -->
  <Style x:Key="FilterRow" TargetType="Grid">
    <Setter Property="Margin" Value="18,8,18,8" />
  </Style>

  <!-- .filterbox{width:150px;height:22px;border:1px solid #ababab} -->
  <Style x:Key="FilterBoxBorder" TargetType="Border">
    <Setter Property="Width" Value="150" />
    <Setter Property="Height" Value="{StaticResource Size.ControlHeight}" />
    <Setter Property="Background" Value="{StaticResource Brush.White}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,0,6,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== 向导步骤条 ==================== -->
  <!-- .steps{border:1px solid #e6e6e6} + 每步 10/12 内边距 + 步骤间 1px 竖线 -->
  <Style x:Key="WizardStepsBorder" TargetType="Border">
    <Setter Property="Margin" Value="18,0,18,0" />
    <Setter Property="Background" Value="{StaticResource Brush.White}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- .steps .step .n{width:20px;height:20px;border:1px solid #ababab} -->
  <Style x:Key="WizardStepNumberBorder" TargetType="Border">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{StaticResource Brush.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== 页头下拉菜单（2026-10-18，S10-a / S10-b） ====================
       设计稿 p18 / p19：白底 + 1px #a0a0a0 边框、**无阴影无圆角**
       （AGENTS.md §5.2 的“无卡片、无阴影、无圆角”同样约束浮层）；
       头行/底行 #fafafa、行悬停 #eaf3fb。 -->
  <Style x:Key="HeaderMenuPopupBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.White}" />
    <Setter Property="BorderBrush" Value="#FFA0A0A0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource Size.BodyFont}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="HeaderMenuHeader" TargetType="Border">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{StaticResource Brush.TableHead}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="HeaderMenuFooter" TargetType="Border">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{StaticResource Brush.TableHead}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="HeaderMenuTitleText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HeaderMenuCountText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- 浮层里的文字链接（头行/底行的「打开页面」、头行右侧的「管理账户」） -->
  <Style x:Key="HeaderMenuLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉里的一行（可整行点：打开页面 / 选为默认账户） -->
  <Style x:Key="HeaderMenuRowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush.RowHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 进行中任务那一块（高度随内容，所以不在 RowButton 上固定 30px） -->
  <Style x:Key="HeaderMenuBlockButton" TargetType="Button" BasedOn="{StaticResource HeaderMenuRowButton}">
    <Setter Property="Padding" Value="10,8,10,6" />
  </Style>

  <!-- 行内动作（取消 / 重试）：小一号的文字链接 -->
  <Style x:Key="HeaderMenuActionButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
    <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Padding" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Brush.StateOff}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="HeaderMenuSep" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.Line}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- 默认账户的「默认」小框（1px 主色边框 + 主色字） -->
  <Style x:Key="HeaderMenuBadge" TargetType="Border">
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="HeaderMenuGlyphText" TargetType="TextBlock">
    <Setter Property="Width" Value="16" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#FF5A5A5A" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
